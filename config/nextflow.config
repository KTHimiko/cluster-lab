// Perfis de execução do Nextflow neste cluster.
//
// Um "executor" é quem de fato roda cada processo do pipeline. Trocar de
// executor não muda o pipeline — muda só onde ele executa. É por isso que o
// mesmo código roda no laptop e num cluster de mil nós.
//
// Uso:
//   nextflow run teste.nf -profile local      # tudo na máquina atual
//   nextflow run teste.nf -profile slurm      # cada processo vira um job
//   nextflow run teste.nf -profile container  # job + container

profiles {

    // Execução local: útil para desenvolver e depurar sem ocupar a fila.
    local {
        process.executor = 'local'
    }

    // Cada processo do pipeline é submetido como um job independente.
    slurm {
        process {
            executor = 'slurm'
            queue    = 'debug'
            cpus     = 1
            memory   = '512 MB'
            time     = '10m'
        }

        executor {
            // Quantos jobs manter na fila ao mesmo tempo. Em cluster
            // compartilhado isso é cortesia: sem limite, um pipeline com
            // milhares de tarefas monopoliza o escalonador.
            queueSize    = 10
            // De quanto em quanto tempo perguntar ao SLURM o que terminou.
            pollInterval = '5 sec'
        }
    }

    // SLURM + Apptainer: cada processo roda dentro de um container.
    container {
        process {
            executor = 'slurm'
            queue    = 'debug'
            cpus     = 1
            memory   = '512 MB'
            time     = '10m'
        }

        executor {
            queueSize    = 10
            pollInterval = '5 sec'
        }

        apptainer {
            enabled    = true
            // Monta automaticamente o diretório de trabalho dentro do
            // container, para o processo enxergar seus próprios arquivos.
            autoMounts = true
            // Imagens ficam no armazenamento compartilhado: baixadas uma
            // vez, usadas por todos os nós.
            cacheDir   = '/home/luan/containers'
            // O Apptainer LIMPA o ambiente ao entrar no container, então as
            // variáveis do SLURM desaparecem lá dentro. O processo continua
            // sendo um job — mas não consegue mais saber qual. Ferramentas
            // que dimensionam paralelismo por essas variáveis passam a errar
            // silenciosamente, então é preciso deixá-las passar.
            envWhitelist = 'SLURM_JOB_ID,SLURM_JOB_NODELIST,SLURM_CPUS_ON_NODE,SLURM_PROCID'
        }
    }
}

// O diretório de trabalho PRECISA estar em armazenamento compartilhado.
// O nó que submete e o nó que executa têm de enxergar os mesmos arquivos —
// é a razão de o NFS existir neste cluster.
workDir = '/home/luan/nf-work'

// Relatórios de execução: úteis para entender onde o tempo foi gasto.
timeline.enabled = true
report.enabled   = true
timeline.overwrite = true
report.overwrite   = true
