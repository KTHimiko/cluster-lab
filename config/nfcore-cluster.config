/*
 * Configuração deste cluster para pipelines nf-core.
 *
 * Pipelines nf-core declaram requisitos pensados para clusters grandes: um
 * processo pode pedir 36 GB e 12 núcleos. Nossos nós têm 2 núcleos e 3,8 GB.
 * Sem truncar esses pedidos, o SLURM rejeita os jobs — eles ficam pendentes
 * para sempre esperando um nó que não existe.
 *
 * `resourceLimits` é o mecanismo atual para isso: o Nextflow reduz qualquer
 * pedido acima do teto, em vez de falhar.
 *
 * Uso:
 *   nextflow run nf-core/demo -r 1.2.0 \
 *     -profile test,apptainer \
 *     -c nfcore-cluster.config \
 *     --outdir resultados
 */

process {
    executor = 'slurm'
    queue    = 'debug'

    // Teto real deste cluster. Qualquer pedido maior é truncado até aqui.
    resourceLimits = [
        cpus   : 2,
        memory : 3.GB,
        time   : 2.h
    ]
}

executor {
    // Seis jobs simultâneos: dois por nó. Mais do que isso só enfileira.
    queueSize    = 6
    pollInterval = '10 sec'
}

apptainer {
    enabled    = true
    autoMounts = true
    // Imagens no armazenamento compartilhado: baixadas uma vez, usadas por
    // todos os nós.
    cacheDir   = '/home/luan/containers'
    // O Apptainer limpa o ambiente ao entrar no container. Sem isto, as
    // ferramentas perdem SLURM_CPUS_ON_NODE e assumem a máquina inteira,
    // competindo com os outros jobs sem nada falhar.
    envWhitelist = 'SLURM_JOB_ID,SLURM_JOB_NODELIST,SLURM_CPUS_ON_NODE,SLURM_PROCID'
}

// Precisa estar em armazenamento compartilhado: quem submete e quem executa
// têm de enxergar os mesmos arquivos.
workDir = '/home/luan/nf-work'

// O container do MultiQC é grande e a rede é lenta; sem folga, o pull estoura
// o tempo limite e o pipeline falha por um motivo que não é dele.
apptainer.pullTimeout = '1 h'
